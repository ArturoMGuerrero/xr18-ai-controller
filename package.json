{
  "name": "xr18-ai-controller",
  "version": "2.0.0",
  "description": "AI-powered controller for Behringer XR18/X32/M32 mixers",
  "main": "build/electron/main.js",
  "author": "Jorge Moreno",
  "license": "MIT",
  "scripts": {
    "frontend:install": "cd frontend && npm install",
    "install:all": "npm install && npm run frontend:install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "electron:dev": "electron .",
    "dev": "npm run electron:build && concurrently -k -n vite,tsc,app \"npm run frontend:dev\" \"npm run electron:watch\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run frontend:build && npm run electron:build && electron-builder",
    "build:win": "npm run frontend:build && npm run electron:build && electron-builder --win",
    "build:mac": "npm run frontend:build && npm run electron:build && electron-builder --mac",
    "build:linux": "npm run frontend:build && npm run electron:build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jorgem.xr18-ai-controller",
    "productName": "XR18 AI Controller",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "frontend/dist/**/*",
      "installer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  }
}
