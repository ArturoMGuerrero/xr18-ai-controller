# XR18 AI Controller - Environment Configuration
# Copy this file to .env and configure your settings

# Mixer Configuration
XR18_IP=192.168.1.1
XR18_PORT=10024
XR18_CHANNELS=16

# Audio Level Thresholds (dB)
MAX_THRESHOLD_DB=-6.0
TARGET_LEVEL_DB=-12.0
MIN_THRESHOLD_DB=-40.0

# AI Configuration
AI_HISTORY_WINDOW=100
AI_CONFIDENCE_THRESHOLD=0.7

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True

# WebSocket Configuration
WS_REFRESH_RATE_MS=50

# Logging
LOG_LEVEL=INFO
